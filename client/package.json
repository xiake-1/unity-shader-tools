{
  "name": "unity-shader-tools",
  "displayName": "Unity Shader Tools",
  "description": "Unity .shader/.hlsl language support (tree-sitter + LSP)",
  "version": "0.0.6",
  "private": true,
  "publisher": "xiake-1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiake-1/unity-shader-tools"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:unityshader",
    "onLanguage:hlsl",
    "onLanguage:UnityShader",
    "workspaceContains:**/*.shader",
    "workspaceContains:**/*.hlsl"
  ],
  "contributes": {
    "configurationDefaults": {
      "[unityshader]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[hlsl]": {
        "editor.wordBasedSuggestions": "off"
      },
      "unityShader.syntaxDiagnostics": true,
      "unityShader.includeDiagnostics": true,
      "unityShader.typeDiagnostics": true,
      "unityShader.formatting.enable": true,
      "unityShader.formatting.intraLineSpacing": true,
      "unityShader.formatting.braceSplitting": true,
      "unityShader.autoFixLanguageId": true,
      "unityShader.dxcMacroOverrides": []
    },
    "languages": [
      {
        "id": "unityshader",
        "aliases": [
          "Unity Shader",
          "ShaderLab"
        ],
        "extensions": [
          ".shader"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hlsl",
        "aliases": [
          "HLSL",
          "Cg"
        ],
        "extensions": [
          ".hlsl",
          ".hlslinc",
          ".cginc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unityshader",
        "scopeName": "source.shaderlab",
        "path": "./syntaxes/shaderlab.tmLanguage.json"
      },
      {
        "language": "hlsl",
        "scopeName": "source.hlsl",
        "path": "./syntaxes/hlsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "unityshader",
        "path": "./snippets/shaderlab.code-snippets"
      },
      {
        "language": "hlsl",
        "path": "./snippets/shaderlab.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "unityshader.showIndexStats",
        "title": "Unity Shader: Show Index Stats"
      },
      {
        "command": "unityshader.refreshShaderKeywords",
        "title": "Unity Shader: Refresh Unity Keywords"
      },
      {
        "command": "unityshader.runTypeDiagnostics",
        "title": "Unity Shader: Run Type Diagnostics (DXC)"
      },
      {
        "command": "unityshader.reportVariants",
        "title": "Unity Shader: Report Shader Variants (This File)"
      },
      {
        "command": "unityshader.reportVariantsProject",
        "title": "Unity Shader: Report Shader Variants (Project)"
      },
      {
        "command": "unityshader.fixFileAssociations",
        "title": "Unity Shader: Fix File Associations"
      }
    ],
    "configuration": {
      "title": "Unity Shader Tools",
      "properties": {
        "unityShader.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "LSP 日志详细程度"
        },
        "unityShader.index": {
          "type": "boolean",
          "default": true,
          "description": "是否后台索引工程内/包内/内置符号"
        },
        "unityShader.maxIndexFileSize": {
          "type": "number",
          "default": 2097152,
          "description": "单文件索引大小上限（字节），超出跳过并记日志"
        },
        "unityShader.unityEditorPath": {
          "type": "string",
          "default": "",
          "description": "Unity Editor 安装目录（含 Data/CGIncludes）；留空则自动发现"
        },
        "unityShader.syntaxDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "语法诊断（tree-sitter ERROR/MISSING → 红波浪线）。默认值与 `npm run gate:diagnostics` 门槛联动：门槛 PASS 才为 true"
        },
        "unityShader.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "「include 未找到」Warning（降级态自动不产）"
        },
        "unityShader.diagnosticsDebounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "maximum": 5000,
          "description": "编辑中间态的发布防抖（毫秒）；0 = 每次编辑即时发布"
        },
        "unityShader.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "单文件诊断条数上限，超出按文档顺序截断并记日志"
        },
        "unityShader.keywordPollMs": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "Unity `Editor.log` 的 mtime 轮询间隔（毫秒）；0 = 关闭轮询（只用打开文档与命令刷新）"
        },
        "unityShader.keywordLogScanBytes": {
          "type": "number",
          "default": 524288,
          "minimum": 1024,
          "description": "读 `Editor.log` 的尾部窗口（字节）；命中行在窗口外视为未命中"
        },
        "unityShader.branchDebounceMs": {
          "type": "number",
          "default": 700,
          "minimum": 0,
          "maximum": 5000,
          "description": "死分支求值与推送的防抖（毫秒），独立于语法诊断"
        },
        "unityShader.typeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "类型诊断（DXC 语义检查 → 红波浪线）。默认值与 `npm run gate:type-diagnostics` 门槛联动：门槛 PASS 才为 true"
        },
        "unityShader.dxcPath": {
          "type": "string",
          "default": "",
          "description": "自备 DXC 可执行文件路径；留空则用随扩展附带的产物（win32-x64 / linux-x64）。macOS 无官方产物，必须自备"
        },
        "unityShader.dxcTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 500,
          "maximum": 60000,
          "description": "单个编译单元的 DXC 编译超时（毫秒）；超时该块不产诊断并记日志"
        },
        "unityShader.maxTypeDiagnosticsPerFile": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "单文件类型诊断条数上限（与语法诊断各自独立），超出按文档顺序截断并记日志"
        },
        "unityShader.formatting.enable": {
          "type": "boolean",
          "default": true,
          "description": "代码格式化（Shift+Alt+F）。默认值与 `npm run gate:format` 门槛联动：门槛 FAIL 时为 false 且不注册 provider。改这一项需重载窗口（能力在 initialize 定死）"
        },
        "unityShader.formatting.braceOnNewLine": {
          "type": "boolean",
          "default": false,
          "description": "HLSL 函数与控制流的左括号换行（Allman）；false 为同行（K&R）"
        },
        "unityShader.formatting.macroMatchIndent": {
          "type": "boolean",
          "default": true,
          "description": "多行调用的续行对齐到左括号列；false 则按块深度缩进"
        },
        "unityShader.formatting.keepBlankLines": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "连续空行的保留上限（0–2）；0 = 块内空行全清"
        },
        "unityShader.formatting.intraLineSpacing": {
          "type": "boolean",
          "default": true,
          "description": "行内空白规范化四类：连续空格压成单空格、调用左括号前空格删除、`.` 后空格删除、逗号后补空格。行尾空白与 token 内部（字符串/注释/宏续行）不动；改值即时生效"
        },
        "unityShader.formatting.braceSplitting": {
          "type": "boolean",
          "default": true,
          "description": "拆行尾 `}`（`return o;}` → 两行）。`};`、`} else {`、一行内的 `{…}` 不拆；改值即时生效"
        },
        "unityShader.maxFormatFileSize": {
          "type": "number",
          "default": 1048576,
          "minimum": 1024,
          "description": "超过该字节数的文档不格式化（返回 null 并记 format=too-large）"
        },
        "unityShader.autoFixLanguageId": {
          "type": "boolean",
          "default": true,
          "description": "当 files.associations 把 .shader/.hlsl 等指向未注册语言 id 时，运行时把受影响文档切到本扩展的语言 id（不改任何设置；配合命令 “Unity Shader: Fix File Associations” 可持久修复）"
        },
        "unityShader.dxcMacroOverrides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "DXC 类型诊断的宏覆盖列表：`NAME`（定义成 1）、`NAME=VALUE`（定义/改值）、`-NAME`（强制不定义）。用户显式条目优先，不被 Editor.log 的 Disabled keywords 减法减掉；非法条目逐条忽略并记日志"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --format=cjs --outfile=dist/extension.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
