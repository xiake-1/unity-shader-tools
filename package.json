{
  "name": "unity-shader-tools",
  "version": "0.0.1",
  "private": true,
  "description": "VSCode extension: Unity Shader (.shader/.hlsl) language support via standard LSP + tree-sitter",
  "workspaces": [
    "client",
    "server",
    "grammar",
    "hlsl",
    "test"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w client",
    "test": "vitest run",
    "test:vscode": "node test/src/runTest.js",
    "vscode:playground": "node test/src/playground.js",
    "bench": "node test/bench/run.mjs",
    "audit:errors": "node test/corpus/errorAudit.mjs",
    "gate:diagnostics": "node test/corpus/diagnosticsGate.mjs",
    "gate:type-diagnostics": "node test/corpus/typeDiagnosticsGate.mjs",
    "dxc:fetch": "node scripts/fetch-dxc.mjs",
    "grammar:generate": "npm run generate -w grammar",
    "grammar:test": "npm run test -w grammar",
    "hlsl:generate": "npm run generate -w hlsl",
    "hlsl:compile": "npm run compile -w hlsl",
    "hlsl:test": "npm run test -w hlsl",
    "gate:format": "node test/corpus/formatGate.mjs",
    "probe:cg-coverage": "node test/corpus/cgCoverageProbe.mjs",
    "gate:variants": "node test/corpus/variantsGate.mjs",
    "native:prebuild": "npm run prebuild -w grammar && npm run prebuild -w hlsl",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jszip": "^3.10.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
