{
  "name": "shaderlab-grammar",
  "version": "0.0.1",
  "private": true,
  "description": "Self-written Unity ShaderLab tree-sitter grammar (T-003)",
  "main": "bindings/node",
  "scripts": {
    "install": "node -e \"const cp=require('child_process'),fs=require('fs');if(fs.existsSync('src/parser.c')){cp.execSync('node-gyp rebuild',{stdio:'inherit'})}else{console.log('[grammar] src/parser.c 未生成（生成物不入库），跳过原生编译——先 npm run generate 再 compile/prebuild')}\"",
    "generate": "tree-sitter generate",
    "compile": "node-gyp rebuild",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "prebuild": "prebuildify --napi --strip"
  },
  "tree-sitter": [
    {
      "scope": "source.shaderlab",
      "file-types": [
        "shader"
      ],
      "highlights": []
    }
  ],
  "devDependencies": {
    "node-gyp": "^13.0.0",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.25.0"
  },
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2",
    "tree-sitter": "^0.22.4",
    "tree-sitter-hlsl": "^0.2.0"
  }
}
